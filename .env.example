# 对外映射端口；正式公网建议只让反向代理访问它。
WORDPAPER_PORT=8770

# 正式域名必须写完整 HTTPS origin，不要带末尾斜杠。
WORDPAPER_PUBLIC_ORIGIN=https://wordpaper.example.com
# 可选的附加 HTTPS 入口，用逗号分隔。每个域名须在 OAuth 服务商登记自己的回调。
WORDPAPER_ADDITIONAL_PUBLIC_ORIGINS=

# 仅公网账号服务。Supabase 使用直连或 Session pooler（5432）。
# 云端部署固定为 postgres，连接串缺失时会中止启动。自托管 SQLite 可留空。
WORDPAPER_STORAGE_BACKEND=
WORDPAPER_DATABASE_URL=
# 仅云端图片存储，使用同一 Supabase 项目的 URL、服务端密钥和私有 bucket。
WORDPAPER_STORAGE_ORIGIN=
WORDPAPER_STORAGE_SECRET=
WORDPAPER_STORAGE_BUCKET=wordpaper-backgrounds
# 32 字节 Base64 主密钥。迁移时使用原模型和语音设置的加密主密钥。
WORDPAPER_MODEL_KEY_BASE64=

# 经本机受控 Nginx / Caddy HTTPS 反代时设为 1，使 Secure cookie 正确生效。
# 反代必须覆盖/追加 X-Forwarded-*，且 8770 只能绑定回环地址，不能让公网绕过反代直连。
TRUST_PROXY=1

# Google Cloud Console → OAuth 2.0 Client（Web application）
# 回调地址必须与控制台登记值逐字符一致。
WORDPAPER_GOOGLE_CLIENT_ID=
WORDPAPER_GOOGLE_CLIENT_SECRET=
WORDPAPER_GOOGLE_REDIRECT_URI=https://wordpaper.example.com/api/auth/google/callback

# GitHub 个人账号 → Settings → Developer settings → OAuth Apps。
# 在云端账号服务配置后，网页和 Mac 跨设备同步都可以使用 GitHub 登录。
WORDPAPER_GITHUB_CLIENT_ID=
WORDPAPER_GITHUB_CLIENT_SECRET=
WORDPAPER_GITHUB_REDIRECT_URI=https://wordpaper.example.com/api/auth/github/callback

# 邮箱注册验证码通过 Resend 发送。FROM 地址必须属于已在 Resend 验证的域名。
WORDPAPER_RESEND_API_KEY=
WORDPAPER_EMAIL_FROM=WordPaper <login@wordpaper.example.com>
